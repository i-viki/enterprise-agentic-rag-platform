# ==============================================================================
# Enterprise Agentic RAG Platform - Example Environment Template (.env.example)
# Duplicate this file to .env and configure values for your deployment.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL 16 + pgvector Database
# ------------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
DATABASE_URL=postgresql://rag_admin:your_secure_postgres_password_here@localhost:5432/enterprise_rag
ASYNC_DATABASE_URL=postgresql+asyncpg://rag_admin:your_secure_postgres_password_here@localhost:5432/enterprise_rag
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# ------------------------------------------------------------------------------
# 2. Redis 7 (Working Memory & StateGraph Checkpointer)
# ------------------------------------------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Local Air-Gapped Model Runtime (Ollama Gateway)
# ------------------------------------------------------------------------------
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.2:3b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=nomic-embed-text:v1.5
GUARD_MODEL_NAME=llama-guard3:1b
LLM_API_KEY=ollama_local_dummy
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 4. Langfuse Agent State Tracing (Self-Hosted v2)
# Generate public and secret keys from Langfuse UI at http://localhost:3100
# ------------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=http://localhost:3100
NEXTAUTH_SECRET=your_random_nextauth_secret_key
SALT=your_random_salt_key
NEXTAUTH_URL=http://localhost:3100
TELEMETRY_ENABLED=false

# ------------------------------------------------------------------------------
# 5. OpenTelemetry & APM Infrastructure
# ------------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=enterprise-agentic-rag-platform
JAEGER_UI_PORT=16686
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=admin

# ------------------------------------------------------------------------------
# 6. Service Ports & Inter-Service Networking
# ------------------------------------------------------------------------------
CORE_API_PORT=8080
MEMORY_SERVICE_PORT=8000
MEMORY_SERVICE_URL=http://localhost:8000
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080
VITE_JAEGER_URL=http://localhost:16686
VITE_LANGFUSE_URL=http://localhost:3100
VITE_PROMETHEUS_URL=http://localhost:9090
VITE_GRAFANA_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 7. Algorithmic Retrieval Tuning
# ------------------------------------------------------------------------------
RRF_K_CONSTANT=60
DEFAULT_RETRIEVAL_TOP_K=5
DEFAULT_TENANT_ID=tenant-enterprise-prod
DEFAULT_CLEARANCE_LEVEL=1
