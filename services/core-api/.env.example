# ==============================================================================
# Java 21 Spring Boot Governance Gateway - Environment Configuration (.env.example)
# ==============================================================================

# Server Port
CORE_API_PORT=8080

# PostgreSQL 16 Data Store
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Redis Working Memory & Token Bucket
REDIS_HOST=localhost
REDIS_PORT=6379

# Inter-Service Routing (Python LangGraph Cognitive Engine)
MEMORY_SERVICE_URL=http://localhost:8000

# Private Local Model Runtime (Ollama Tier-1.5 Safety Guard)
LLM_BASE_URL=http://localhost:11434
GUARD_MODEL_NAME=llama-guard3:1b

# OpenTelemetry Distributed Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=guardrail-governance-service

