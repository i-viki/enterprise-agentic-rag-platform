# ==============================================================================
# Python Memory Service - Environment Example (.env.example)
# ==============================================================================

# Database Configuration (PostgreSQL 16 + pgvector)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=enterprise_rag
POSTGRES_USER=rag_admin
POSTGRES_PASSWORD=your_secure_postgres_password_here
DB_POOL_MIN_SIZE=5
DB_POOL_MAX_SIZE=20

# Redis Configuration (Working Memory & Checkpointing)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_ENABLED=true

# Private Local Model Serving Gateway (Ollama)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL_NAME=llama3.2:3b
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL_NAME=nomic-embed-text:v1.5
GUARD_MODEL_NAME=llama-guard3:1b
LLM_API_KEY=ollama_local_dummy
EMBEDDING_DIMENSION=768

# Observability & Tracing
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=hybrid-retrieval-memory-engine
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key-here
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key-here
LANGFUSE_HOST=http://localhost:3100

# Algorithmic Retrieval Parameters
RRF_K_CONSTANT=60
DEFAULT_RETRIEVAL_TOP_K=5

