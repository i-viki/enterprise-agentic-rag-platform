{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuditEntryEvent",
  "type": "object",
  "required": [
    "trace_id",
    "tenant_id",
    "user_id",
    "event_type",
    "guardrail_status",
    "execution_time_ms"
  ],
  "properties": {
    "trace_id": { "type": "string" },
    "tenant_id": { "type": "string" },
    "user_id": { "type": "string" },
    "event_type": { "type": "string" },
    "prompt_raw_length": { "type": "integer" },
    "prompt_sanitized_length": { "type": "integer" },
    "pii_entities_detected": { "type": "array", "items": { "type": "string" } },
    "guardrail_status": { "type": "string", "enum": ["CLEAN", "SANITIZED", "BLOCKED"] },
    "guardrail_verdict_notes": { "type": "array" },
    "retrieved_memory_ids": { "type": "array", "items": { "type": "string" } },
    "evaluation_scores": { "type": "object" },
    "execution_time_ms": { "type": "integer" }
  }
}
